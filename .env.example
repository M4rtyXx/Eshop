# Vygenerujte: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=
# Při veřejném provozu vyplňte přesný HTTPS původ bez lomítka na konci.
# PUBLIC_ORIGIN=https://shop.example.cz
PUBLIC_ORIGIN=
MAX_STORAGE_MB=1024
# Za reverzní proxy nastavte pouze IP / síť důvěryhodné proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
